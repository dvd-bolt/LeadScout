BOT_TOKEN=telegram_bot_token
GEMINI_API_KEY=google_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
SESSION_ENCRYPTION_KEY=generate_with_cryptography_fernet

MAX_CONCURRENT_BROWSERS=2
MAX_ACCOUNTS_PER_USER=5
DEFAULT_DAILY_LIMIT=50
DEFAULT_MIN_DELAY_SEC=30
DEFAULT_MAX_DELAY_SEC=180
BROWSER_HEADLESS=true

PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=40
PDF_MAX_TEXT_CHARS=50000
GEMINI_TIMEOUT_MS=60000

# Telegram Mini App / HTTP server
# The public HTTPS hostname used by Caddy and BotFather.
DOMAIN=leadscout.example.com
# Comma-separated owners. Legacy OWNER_TELEGRAM_ID is also supported.
OWNER_TELEGRAM_IDS=123456789,987654321
APP_URL=https://leadscout.example.com
WEB_SESSION_TTL_SEC=28800
WEB_APP_ORIGINS=https://leadscout.example.com
WEB_SECURE_COOKIES=true
